// PostgreSQL + Prisma database foundation for Mini ERP + CRM.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum MovementType {
  IN
  OUT
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdCustomers      Customer[]         @relation("CustomerCreatedBy")
  createdFollowUps      CustomerFollowUp[] @relation("FollowUpCreatedBy")
  createdStockMovements StockMovement[]    @relation("StockMovementCreatedBy")
  createdChallans       Challan[]          @relation("ChallanCreatedBy")

  @@index([role])
  @@map("users")
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(160)
  mobile       String         @db.VarChar(32)
  email        String?        @db.VarChar(255)
  businessName String?        @db.VarChar(160)
  gstNumber    String?        @db.VarChar(80)
  customerType CustomerType
  address      String?        @db.Text
  status       CustomerStatus @default(LEAD)
  followUpDate DateTime?
  notes        String?        @db.Text
  createdById  String?        @db.Uuid
  createdBy    User?          @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customerFollowUps CustomerFollowUp[] @relation("CustomerFollowUps")
  challans          Challan[]          @relation("CustomerChallans")

  @@index([mobile])
  @@index([status])
  @@index([followUpDate])
  @@index([customerType])
  @@map("customers")
}

model CustomerFollowUp {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid
  customer     Customer @relation("CustomerFollowUps", fields: [customerId], references: [id], onDelete: Cascade)
  note         String   @db.Text
  followUpDate DateTime
  createdById  String?  @db.Uuid
  createdBy    User?    @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@map("customer_follow_ups")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  location  String   @db.VarChar(160)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] @relation("WarehouseProducts")

  @@map("warehouses")
}

model Product {
  id                String     @id @default(uuid()) @db.Uuid
  name              String     @db.VarChar(160)
  sku               String     @unique @db.VarChar(80)
  category          String?    @db.VarChar(80)
  unitPrice         Decimal    @db.Decimal(12, 2)
  currentStock      Int        @default(0) @db.Integer
  minimumStockAlert Int        @default(0) @db.Integer
  warehouseId       String?    @db.Uuid
  warehouse         Warehouse? @relation("WarehouseProducts", fields: [warehouseId], references: [id], onDelete: Restrict)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  stockMovements StockMovement[]
  challanItems   ChallanItem[]

  @@index([category])
  @@index([warehouseId])
  @@map("products")
}

model StockMovement {
  id           String       @id @default(uuid()) @db.Uuid
  productId    String       @db.Uuid
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  challanId    String?      @db.Uuid
  challan      Challan?     @relation(fields: [challanId], references: [id], onDelete: Restrict)
  quantity     Int          @db.Integer
  movementType MovementType
  reason       String       @db.VarChar(160)
  createdById  String?      @db.Uuid
  createdBy    User?        @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Challan {
  id            String        @id @default(uuid()) @db.Uuid
  challanNumber String        @unique @db.VarChar(80)
  customerId    String        @db.Uuid
  customer      Customer      @relation("CustomerChallans", fields: [customerId], references: [id], onDelete: Restrict)
  status        ChallanStatus
  totalQuantity Int           @db.Integer
  createdById   String?       @db.Uuid
  createdBy     User?         @relation("ChallanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  confirmedAt   DateTime?
  updatedAt     DateTime      @updatedAt

  challanItems   ChallanItem[]
  stockMovements StockMovement[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("challans")
}

model ChallanItem {
  id                  String  @id @default(uuid()) @db.Uuid
  challanId           String  @db.Uuid
  challan             Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId           String  @db.Uuid
  product             Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productNameSnapshot String  @db.VarChar(160)
  productSkuSnapshot  String  @db.VarChar(80)
  unitPriceSnapshot   Decimal @db.Decimal(12, 2)
  quantity            Int     @db.Integer
  lineTotal           Decimal @db.Decimal(12, 2)

  @@index([challanId])
  @@index([productId])
  @@map("challan_items")
}
